# Bu faylı ".env" adı ilə kopyalayın və dəyərləri dəyişin. ".env" gizli məlumat saxlayır və git tərəfindən nəzərə alınmır:
# onu heç vaxt commit etməyin. "docker compose" onu avtomatik oxuyur.

# Verilənlər bazası administratorunun ("sa") parolu. SQL Server zəif parolu qəbul etmir və qalxmır: ən azı 8 simvol,
# böyük hərf, kiçik hərf, rəqəm və simvol işlədin. Parolda ; ' " və $ olmasın, çünki o, bağlantı sətrinə də yazılır.
SA_PASSWORD=ChangeMe!Str0ngPassw0rd

# Giriş token-larını imzalayan açar: ən azı 32 simvoldan ibarət təsadüfi mətn (boşluqsuz). Məsələn:  openssl rand -base64 48
JWT_SECRET_KEY=replace-this-with-a-long-random-text-of-at-least-32-chars

# İlk universitet və onun admini. Parol boş qalsa, admin yaradılmır. Parolu mütləq dəyişin.
SEED_TENANT_CODE=DEMO
SEED_TENANT_NAME=Demo Universiteti
SEED_ADMIN_EMAIL=admin@demo.az
SEED_ADMIN_PASSWORD=

# Optional. Production (standart) və ya Development.
ASPNETCORE_ENVIRONMENT=Production
