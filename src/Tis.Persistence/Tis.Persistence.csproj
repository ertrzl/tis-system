<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Tis.Application.Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplication (migrate on start) üçün ASP.NET Core paylaşılan çərçivəsi. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <!-- Microsoft.Data.SqlClient köhnə System.Security.Cryptography.Pkcs gətirir (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7):
         bu birbaşa istinad onu düzəldilmiş versiyaya qaldırır. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Tis.Application\Tis.Application.csproj" />
  </ItemGroup>

</Project>
